# Core
APP_PORT=8000
APP_BASE_URL=http://localhost:8000
APP_PUBLIC_URL=http://localhost:8000
APP_INTERNAL_URL=http://app:8000
WEB_CONCURRENCY=4
LOG_LEVEL=INFO
TZ=Europe/Moscow
LOCAL_UID=1000
LOCAL_GID=1000

# Security
ADMIN_TOKEN=change-me
PUBLIC_KEY=change-me
WEBHOOK_SECRET=change-me
WA_INTERNAL_TOKEN=change-me

# Runtime
TENANTS_DIR=/data/tenants
TG_SESSIONS_DIR=/app/tg-sessions
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/postgres

# AI
AI_ENABLED=1
SMART_REPLY_ENABLED=1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TEMPERATURE=0.7
OPENAI_TIMEOUT_SECONDS=45
SMART_REPLY_TIMEOUT_SECONDS=25
PLANNER_ATTEMPTS=3
RESPONSE_PIPELINE_ENABLED=1

# Message pipeline
INBOX_ENABLED=1
OUTBOX_ENABLED=1
OUTBOX_DB_WORKER=0
SMART_REPLY_DELAY_MIN_SECONDS=40
SMART_REPLY_DELAY_MAX_SECONDS=70
SMART_REPLY_SPLIT_PART_DELAY_ENABLED=1

# Telegram (transport)
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
TG_WORKER_URL=http://tgworker:8000
WORKER_BASE_URL=http://tgworker:8000
TGWORKER_URL=http://tgworker:8000
TGWORKER_ADMIN_TOKEN=change-me

# WhatsApp/Web bridges
WA_WEB_URL=http://waweb:9001
WAWEB_BASE_URL=http://waweb:9001
WA_WEB_TOKEN=change-me
WAWEB_DEBUG=0
WAWEB_NETWORK_NAME=default
WAWEB_STATE_DIR=/data/wa_state

# amoCRM
AMOCRM_CLIENT_ID=
AMOCRM_CLIENT_SECRET=
AMOCRM_REDIRECT_URL=
AMOCRM_CHAT_ENABLED=1
AMOCRM_CHAT_CHANNEL_ID=
AMOCRM_CHAT_SECRET=
AMOCRM_CHAT_SOURCE_ID=
AMOCRM_CHAT_BOT_ID=
AMOCRM_CHAT_TITLE=Avio

# Avito
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=
AVITO_REDIRECT_URL=
AVITO_TOKEN_ENCRYPTION_KEY=change-me-32-bytes-min

# Infra (optional)
CF_TOKEN=

# Email auth (optional)
ENABLE_EMAIL_AUTH=0
AUTH_FALLBACK_MAGIC_LINK=0
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TLS=1
SMTP_SSL=0
