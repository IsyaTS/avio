dev.avio.website {
  @n8n_telegram_webhook path /telegram-bot/webhook/* /telegram-bot/webhook-test/*
  handle @n8n_telegram_webhook {
    uri strip_prefix /telegram-bot
    reverse_proxy http://n8n:5678
  }

  reverse_proxy http://app:8000
}

